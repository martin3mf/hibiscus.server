#parse("includes/header.vm")

<div id="breadcrumbs">
  <a href="/hibiscus/">Home</a>
  &raquo; <a href="freigabe.html">Zahlungsfreigabe</a>
</div>

<div id="msg" class="note" style="display:none"></div>

<div id="vop" style="display:none">
  <h2>Namensabgleich des Empf&auml;ngers &ndash; Entscheidung erforderlich</h2>
  <div class="note" style="border:1px dotted #800000;background-color: #F7E7E0">
    Ohne Entscheidung wird der Auftrag um <span id="vop-deadline"></span> abgelehnt.
    <span id="vop-auftrag"></span>
    <span id="vop-text"></span>
  </div>
  <table class="data">
    <thead>
      <tr>
        <th>Ergebnis</th>
        <th>Angegebener Name</th>
        <th>Name laut Bank</th>
        <th>IBAN</th>
        <th style="text-align:right">Betrag</th>
        <th>Verwendungszweck</th>
      </tr>
    </thead>
    <tbody id="vop-items"></tbody>
  </table>
  <div style="margin-top:10px">
    <button type="button" onclick="freigabe.decide('approve')">Auftrag dennoch ausf&uuml;hren</button>
    <button type="button" onclick="freigabe.decide('reject')">Abbrechen</button>
  </div>
</div>

<h2>F&auml;llige SEPA-&Uuml;berweisungen</h2>

<div id="running" class="note" style="display:none"><b>Ausf&uuml;hrung l&auml;uft.</b> Bei einer Push-Freigabe bitte in SecureGo plus best&auml;tigen.</div>

<table class="data">
  <thead>
    <tr>
      <th><input type="checkbox" id="all" title="Alle ausw&auml;hlen" onclick="freigabe.selectAll(this.checked)"></th>
      <th>Termin</th>
      <th>Empf&auml;nger</th>
      <th>IBAN</th>
      <th style="text-align:right">Betrag</th>
      <th>Verwendungszweck</th>
    </tr>
  </thead>
  <tbody id="transfers"><tr><td colspan="6">Lade ...</td></tr></tbody>
</table>
<div style="margin-top:10px">
  <button type="button" id="execute" onclick="freigabe.execute()">Ausgew&auml;hlte &Uuml;berweisungen ausf&uuml;hren</button>
</div>

<div style="margin-top:20px">
  #parse("includes/log.vm")
</div>

<script type="text/javascript">
var freigabe = (function()
{
  var token   = "$c.getToken()";
  var vopId   = null;
  var lastList = null;
  var busy    = false;

  function el(id) { return document.getElementById(id); }

  // Zeile aus Textwerten bauen; textContent verhindert XSS aus Bank- oder DB-Texten
  function row(values, rightCol)
  {
    var tr = document.createElement("tr");
    values.forEach(function(v, i)
    {
      var td = document.createElement("td");
      if (v instanceof Node) td.appendChild(v); else td.textContent = v;
      if (i == rightCol) td.style.textAlign = "right";
      tr.appendChild(td);
    });
    return tr;
  }

  function message(text, ok)
  {
    var m = el("msg");
    m.textContent = text;
    m.style.color = ok ? "" : "#800000";
    m.style.display = text ? "" : "none";
  }

  function post(params)
  {
    var body = new URLSearchParams(params);
    body.append("token", token);
    return fetch("freigabe.html", {method: "POST", body: body, credentials: "same-origin"})
      .then(function(r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
      .then(function(res) { message(res.text, res.ok); refresh(); })
      .catch(function(e) { message("Fehler: " + e.message, false); });
  }

  function render(s)
  {
    el("running").style.display = s.running ? "" : "none";
    el("execute").style.display = s.running ? "none" : "";

    var p = s.pending;
    el("vop").style.display = p ? "" : "none";
    vopId = p ? p.id : null;
    if (p)
    {
      el("vop-deadline").textContent = p.deadline;
      el("vop-auftrag").textContent = p.auftrag ? "Auftrag: " + p.auftrag : "";
      el("vop-text").textContent = p.text ? " Text der Bank: " + p.text : "";
      var items = el("vop-items");
      items.innerHTML = "";
      p.items.forEach(function(i) { items.appendChild(row([i.status, i.original, i.name, i.iban, i.amount, i.usage], 4)); });
    }

    // Tabelle nur neu aufbauen, wenn sich die Liste geaendert hat; Auswahl bleibt erhalten
    var list = JSON.stringify(s.transfers);
    if (list == lastList)
      return;
    lastList = list;
    var checked = {};
    document.querySelectorAll("input[name=id]:checked").forEach(function(c) { checked[c.value] = true; });
    var body = el("transfers");
    body.innerHTML = "";
    if (s.transfers.length == 0)
      body.appendChild(row(["", "Keine f\u00e4lligen \u00dcberweisungen", "", "", "", ""], -1));
    s.transfers.forEach(function(u)
    {
      var cb = document.createElement("input");
      cb.type = "checkbox";
      cb.name = "id";
      cb.value = u.id;
      cb.checked = !!checked[u.id];
      body.appendChild(row([cb, u.termin, u.name, u.iban, u.betrag, u.zweck], 4));
    });
    el("all").checked = false;
  }

  function refresh()
  {
    if (busy)
      return;
    busy = true;
    fetch("freigabe.html?action=status", {credentials: "same-origin", cache: "no-store"})
      .then(function(r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
      .then(render)
      .catch(function(e) { message("Status nicht abrufbar: " + e.message, false); })
      .then(function() { busy = false; });
  }

  refresh();
  window.setInterval(refresh, 3000);

  return {
    selectAll: function(b)
    {
      document.querySelectorAll("input[name=id]").forEach(function(c) { c.checked = b; });
    },
    execute: function()
    {
      var ids = [];
      document.querySelectorAll("input[name=id]:checked").forEach(function(c) { ids.push(["id", c.value]); });
      if (ids.length == 0) { message("Keine \u00dcberweisung ausgew\u00e4hlt", false); return; }
      if (!window.confirm(ids.length + " \u00dcberweisung(en) jetzt an die Bank senden?"))
        return;
      ids.push(["action", "execute"]);
      post(ids);
    },
    decide: function(action)
    {
      if (vopId)
        post([["action", action], ["vop", vopId]]);
    }
  };
})();
</script>

#parse("includes/footer.vm")
