#parse("includes/header.vm")

<div id="breadcrumbs">
  <a href="/hibiscus/">Home</a>
  &raquo; <a href="freigabe.html">Zahlungsfreigabe</a>
</div>

<div id="msg" class="note" style="display:none"></div>

<div id="vop" style="display:none">
  <h2>Namensabgleich des Empf&auml;ngers &ndash; Entscheidung erforderlich</h2>
  <div class="note" style="border:1px dotted #800000;background-color: #F7E7E0">
    Ohne Entscheidung wird der Auftrag um <span id="vop-deadline"></span> abgelehnt.
    <span id="vop-auftrag"></span>
    <span id="vop-text"></span>
  </div>
  <table class="data">
    <thead>
      <tr>
        <th>Ergebnis</th>
        <th>Angegebener Name</th>
        <th>Name laut Bank</th>
        <th>IBAN</th>
        <th style="text-align:right">Betrag</th>
        <th>Verwendungszweck</th>
      </tr>
    </thead>
    <tbody id="vop-items"></tbody>
  </table>
  <div style="margin-top:10px" id="vop-buttons"></div>
</div>

<div id="running" class="note" style="display:none"><b>Ausf&uuml;hrung l&auml;uft:</b> <span id="running-step"></span></div>

<div id="tan" style="display:none;position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,0.4);z-index:100">
  <div style="max-width:560px;margin:120px auto;background:#fff;border:2px solid #800000;padding:20px">
    <h2 style="margin-top:0">Freigabe in SecureGo plus erforderlich</h2>
    <p id="tan-retry" style="display:none;color:#800000"><b>Die Bank meldet: noch nicht freigegeben.</b></p>
    <p>Bitte den Auftrag jetzt in der App SecureGo plus freigeben.</p>
    <p id="tan-auftrag"></p>
    <p id="tan-text" style="white-space:pre-wrap"></p>
    <p>Der Server wartet noch <b id="tan-remaining"></b> Sekunden und fragt dann die Bank.</p>
    <div id="tan-buttons"></div>
  </div>
</div>

<p>
  <label><input type="checkbox" id="showall" onclick="freigabe.refresh(true)"> Auch noch nicht f&auml;llige Auftr&auml;ge anzeigen</label>
</p>

<div id="edit" class="note" style="display:none">
  <b id="edit-title"></b><br>
  <table>
    <tr><td>Betrag (EUR)</td><td><input type="text" id="edit-betrag" size="12"></td></tr>
    <tr><td>Verwendungszweck</td><td><input type="text" id="edit-zweck" size="70" maxlength="140"></td></tr>
    <tr><td>Ausf&uuml;hrungstermin</td><td><input type="date" id="edit-datum"></td></tr>
    <tr id="edit-ziel-row"><td>F&auml;lligkeit beim Zahler</td><td><input type="date" id="edit-ziel"></td></tr>
  </table>
  <button type="button" onclick="freigabe.save()">Speichern</button>
  <button type="button" onclick="freigabe.cancel()">Abbrechen</button>
</div>

<h2>SEPA-&Uuml;berweisungen</h2>

<div style="margin-bottom:10px">
  Auswahl &auml;ndern:
  <select id="batch-typ">
    <option value="">Typ unver&auml;ndert</option>
    <option value="normal">Standard</option>
    <option value="termin">Termin&uuml;berweisung</option>
    <option value="instant">Echtzeit&uuml;berweisung</option>
  </select>
  <input type="date" id="batch-datum" title="Ausf&uuml;hrungstermin, leer = unver&auml;ndert">
  <button type="button" onclick="freigabe.batch()">Auf Auswahl anwenden</button>
</div>

<table class="data">
  <thead>
    <tr>
      <th><input type="checkbox" title="Alle ausw&auml;hlen" onclick="freigabe.selectAll('id',this.checked)"></th>
      <th>Termin</th>
      <th>Typ</th>
      <th>Empf&auml;nger</th>
      <th>IBAN</th>
      <th style="text-align:right">Betrag</th>
      <th>Verwendungszweck</th>
      <th></th>
    </tr>
  </thead>
  <tbody id="transfers"><tr><td colspan="8">Lade ...</td></tr></tbody>
</table>
<div style="margin-top:10px">
  <button type="button" class="execute" onclick="freigabe.execute('id')">Ausgew&auml;hlte &Uuml;berweisungen ausf&uuml;hren</button>
</div>

<h2>SEPA-Lastschriften</h2>

<table class="data">
  <thead>
    <tr>
      <th><input type="checkbox" title="Alle ausw&auml;hlen" onclick="freigabe.selectAll('last',this.checked)"></th>
      <th>Termin</th>
      <th>F&auml;lligkeit</th>
      <th>Zahler</th>
      <th>IBAN</th>
      <th style="text-align:right">Betrag</th>
      <th>Mandat</th>
      <th>Verwendungszweck</th>
      <th></th>
    </tr>
  </thead>
  <tbody id="debits"><tr><td colspan="9">Lade ...</td></tr></tbody>
</table>
<div style="margin-top:10px">
  <button type="button" class="execute" onclick="freigabe.execute('last')">Ausgew&auml;hlte Lastschriften einziehen</button>
  <button type="button" class="execute" onclick="freigabe.merge()">Zu Sammellastschrift zusammenfassen</button>
</div>

<h2>SEPA-Sammellastschriften</h2>

<table class="data">
  <thead>
    <tr>
      <th><input type="checkbox" title="Alle ausw&auml;hlen" onclick="freigabe.selectAll('sammel',this.checked)"></th>
      <th>Termin</th>
      <th>F&auml;lligkeit</th>
      <th>Bezeichnung</th>
      <th style="text-align:right">Anzahl</th>
      <th style="text-align:right">Summe</th>
    </tr>
  </thead>
  <tbody id="collective"><tr><td colspan="6">Lade ...</td></tr></tbody>
</table>
<div style="margin-top:10px">
  <button type="button" class="execute" onclick="freigabe.execute('sammel')">Ausgew&auml;hlte Sammellastschriften einziehen</button>
</div>

<h2>Freigabeliste Namensabgleich</h2>

<p>Manuelle Eintr&auml;ge (IBAN + Name im Auftrag) geben &bdquo;Beinahe-&Uuml;bereinstimmung&ldquo; und &bdquo;Keine &Uuml;bereinstimmung&ldquo; automatisch frei.
Gemerkte Kombinationen geben nur &bdquo;Beinahe-&Uuml;bereinstimmung&ldquo; mit demselben Namen laut Bank frei.</p>

<div style="margin-bottom:10px">
  IBAN <input type="text" id="allow-iban" size="34">
  Name <input type="text" id="allow-name" size="40" maxlength="140">
  <button type="button" onclick="freigabe.allowAdd()">Aufnehmen</button>
</div>

<table class="data">
  <thead>
    <tr>
      <th>Art</th>
      <th>IBAN</th>
      <th>Name im Auftrag</th>
      <th>Name laut Bank</th>
      <th>Seit</th>
      <th></th>
    </tr>
  </thead>
  <tbody id="allow"><tr><td colspan="6">Lade ...</td></tr></tbody>
</table>

<style>
  table.data tr.INFO td, table.data tr.DEBUG td { color: #46824A; }
  table.data tr.WARN td { color: #5770B2; }
  table.data tr.ERROR td { color: #6E1416; background: #FFAC95; }
</style>
<h2>System-Log</h2>
<div style="border:1px solid #a5a5a5;height:300px;overflow:auto;overflow-x:hidden">
  <table class="data" style="border:none;margin:0;padding:0">
    <thead><tr><th>Datum</th><th>Quelle</th><th>Text</th></tr></thead>
    <tbody id="log"></tbody>
  </table>
</div>

<script type="text/javascript">
var freigabe = (function()
{
  var token   = "$c.getToken()";
  var vopId   = null; // Entscheidung, fuer die die Buttons gebaut sind
  var tanId   = null; // Push-Freigabe, fuer die der Button gebaut ist
  var tanLeft = 0;
  var last    = {};
  var data    = {};
  var editing = null;
  var busy    = false;
  var queued  = false;
  var TYP     = {normal: "Standard", termin: "Termin", instant: "Echtzeit", umbuchung: "Umbuchung"};

  function el(id) { return document.getElementById(id); }

  // Zeile aus Textwerten bauen; textContent verhindert XSS aus Bank- oder DB-Texten
  function row(values, rightCol)
  {
    var tr = document.createElement("tr");
    values.forEach(function(v, i)
    {
      var td = document.createElement("td");
      if (v instanceof Node) td.appendChild(v); else td.textContent = v;
      if (i == rightCol) td.style.textAlign = "right";
      tr.appendChild(td);
    });
    return tr;
  }

  function message(text, ok)
  {
    var m = el("msg");
    m.textContent = text;
    m.style.color = ok ? "" : "#800000";
    m.style.display = text ? "" : "none";
  }

  function checkedIds(name)
  {
    var ids = [];
    document.querySelectorAll("input[name=" + name + "]:checked").forEach(function(c) { ids.push(c.value); });
    return ids;
  }

  function post(params)
  {
    var body = new URLSearchParams(params);
    body.append("token", token);
    return fetch("freigabe.html", {method: "POST", body: body, credentials: "same-origin"})
      .then(function(r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
      .then(function(res) { message(res.text, res.ok); refresh(true); return res.ok; })
      .catch(function(e) { message("Fehler: " + e.message, false); return false; });
  }

  // Tabelle nur neu aufbauen, wenn sich die Liste geaendert hat; Auswahl bleibt erhalten
  function table(bodyId, name, list, cols, rightCol, emptyText, force)
  {
    var json = JSON.stringify(list);
    if (!force && json == last[bodyId])
      return;
    last[bodyId] = json;
    var checked = {};
    checkedIds(name).forEach(function(id) { checked[id] = true; });
    var body = el(bodyId);
    body.innerHTML = "";
    if (list.length == 0)
      body.appendChild(row(["", emptyText], -1));
    list.forEach(function(u)
    {
      var cb = document.createElement("input");
      cb.type = "checkbox";
      cb.name = name;
      cb.value = u.id + ":" + u.fp; // ID + Fingerabdruck: eine wiederverwendete ID uebernimmt keine Auswahl
      cb.checked = !!checked[cb.value];
      var cells = [cb].concat(cols(u));
      if (name != "sammel")
      {
        var edit = document.createElement("a");
        edit.href = "#";
        edit.textContent = "bearbeiten";
        edit.onclick = function() { openEdit(name, u); return false; };
        cells.push(edit);
      }
      var tr = row(cells, rightCol);
      if (!u.faellig) tr.style.color = "#808080";
      body.appendChild(tr);
    });
  }

  function render(s)
  {
    el("running").style.display = s.running ? "" : "none";
    el("running-step").textContent = s.log.length ? s.log[0].text : "";
    renderTan(s.tan);
    renderLog(s.log);
    document.querySelectorAll("button.execute").forEach(function(b) { b.style.display = s.running ? "none" : ""; });

    var p = s.pending;
    el("vop").style.display = p ? "" : "none";
    // Buttons je Entscheidung neu bauen, mit fest gebundener ID: ein laufender Klick kann nicht auf eine neue Entscheidung wechseln
    if ((p ? p.id : null) !== vopId)
    {
      vopId = p ? p.id : null;
      var buttons = el("vop-buttons");
      buttons.innerHTML = "";
      if (p)
      {
        var id = p.id;
        var add = function(text, action)
        {
          var b = document.createElement("button");
          b.type = "button";
          b.textContent = text;
          b.onclick = function() { post([["action", action], ["vop", id]]); };
          buttons.appendChild(b);
          buttons.appendChild(document.createTextNode(" "));
        };
        add("Auftrag dennoch ausf\u00fchren", "approve");
        if (p.learnable)
          add("Ausf\u00fchren und diese Kombination immer akzeptieren", "remember");
        add("Abbrechen", "reject");
      }
    }
    if (p)
    {
      el("vop-deadline").textContent = p.deadline;
      el("vop-auftrag").textContent = p.auftrag ? "Auftrag: " + p.auftrag : "";
      el("vop-text").textContent = p.text ? " Text der Bank: " + p.text : "";
      var items = el("vop-items");
      items.innerHTML = "";
      p.items.forEach(function(i) { items.appendChild(row([i.status, i.original, i.name, i.iban, i.amount, i.usage], 4)); });
    }

    renderAllow(s.allow);

    var none = el("showall").checked ? "Keine offenen " : "Keine f\u00e4lligen ";
    table("transfers", "id", s.transfers, function(u) { return [u.termin, TYP[u.typ] || u.typ, u.name, u.iban, u.betrag, u.zweck]; }, 5, none + "\u00dcberweisungen", s.force);
    table("collective", "sammel", s.collective, function(u) { return [u.termin, u.ziel, u.bezeichnung, String(u.anzahl), u.summe]; }, 5, none + "Sammellastschriften", s.force);
    table("debits", "last", s.debits, function(u) { return [u.termin, u.ziel, u.name, u.iban, u.betrag, u.mandat + " (" + u.sequenz + ")", u.zweck]; }, 5, none + "Lastschriften", s.force);
  }

  function renderTan(t)
  {
    el("tan").style.display = t ? "" : "none";
    // Button je Push-Freigabe neu bauen, mit fest gebundener ID
    if ((t ? t.id : null) !== tanId)
    {
      tanId = t ? t.id : null;
      var buttons = el("tan-buttons");
      buttons.innerHTML = "";
      if (t)
      {
        var id = t.id;
        var b = document.createElement("button");
        b.type = "button";
        b.textContent = "In SecureGo plus freigegeben \u2013 weiter";
        b.onclick = function() { b.disabled = true; post([["action", "tanConfirm"], ["tan", id]]).then(function(ok) { if (!ok) b.disabled = false; }); };
        buttons.appendChild(b);
      }
    }
    if (t)
    {
      tanLeft = t.remaining;
      el("tan-remaining").textContent = String(tanLeft);
      el("tan-retry").style.display = t.retry ? "" : "none";
      el("tan-auftrag").textContent = t.auftrag ? "Auftrag: " + t.auftrag : "";
      el("tan-text").textContent = t.text ? "Text der Bank: " + t.text : "";
    }
  }

  function renderLog(list)
  {
    var body = el("log");
    body.innerHTML = "";
    list.forEach(function(l)
    {
      var tr = row([l.date, l.class, l.text]);
      tr.className = l.level;
      body.appendChild(tr);
    });
  }

  function renderAllow(list)
  {
    var json = JSON.stringify(list);
    if (json == last.allow)
      return;
    last.allow = json;
    var body = el("allow");
    body.innerHTML = "";
    if (list.length == 0)
      body.appendChild(row(["Keine Eintr\u00e4ge"], -1));
    list.forEach(function(a)
    {
      var del = document.createElement("a");
      del.href = "#";
      del.textContent = "entfernen";
      del.onclick = function()
      {
        if (window.confirm("Eintrag " + a.iban + " / " + a.name + " entfernen?"))
          post([["action", "allowRemove"], ["eintrag", a.key]]);
        return false;
      };
      body.appendChild(row([a.manuell ? "manuell" : "gemerkt", a.iban, a.name, a.bank, a.datum, del], -1));
    });
  }

  function refresh(force)
  {
    // Laeuft schon eine Abfrage, eine erzwungene merken und danach nachholen; eine Antwort fuer einen alten Filter verwerfen
    if (busy)
    {
      if (force === true)
        queued = true;
      return;
    }
    busy = true;
    var all = el("showall").checked;
    fetch("freigabe.html?action=status" + (all ? "&all=1" : ""), {credentials: "same-origin", cache: "no-store"})
      .then(function(r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
      .then(function(s)
      {
        if (all !== el("showall").checked)
        {
          queued = true;
          return;
        }
        s.force = force === true;
        render(s);
      })
      .catch(function(e) { message("Status nicht abrufbar: " + e.message, false); })
      .then(function()
      {
        busy = false;
        if (queued)
        {
          queued = false;
          refresh(true);
        }
      });
  }

  function openEdit(name, u)
  {
    var debit = name == "last";
    editing = {kind: debit ? "last" : "ueb", ref: u.id + ":" + u.fp};
    el("edit-title").textContent = (debit ? "Lastschrift von " : "\u00dcberweisung an ") + u.name + " (" + u.iban + ")";
    el("edit-betrag").value = u.wert;
    el("edit-zweck").value = u.zweck;
    el("edit-datum").value = u.terminIso;
    el("edit-ziel").value = debit ? u.zielIso : "";
    el("edit-ziel-row").style.display = debit ? "" : "none";
    el("edit").style.display = "";
    el("edit-betrag").focus();
  }

  refresh(true);
  window.setInterval(refresh, 3000);
  // Countdown zwischen zwei Statusabfragen weiterzaehlen
  window.setInterval(function()
  {
    if (tanId && tanLeft > 0)
      el("tan-remaining").textContent = String(--tanLeft);
  }, 1000);

  return {
    refresh: refresh,
    selectAll: function(name, b)
    {
      document.querySelectorAll("input[name=" + name + "]").forEach(function(c) { c.checked = b; });
    },
    execute: function(name)
    {
      var ids = checkedIds(name);
      var what = name == "id" ? "\u00dcberweisung(en) jetzt an die Bank senden" : (name == "sammel" ? "Sammellastschrift(en)" : "Lastschrift(en)") + " jetzt bei der Bank einziehen";
      if (ids.length == 0) { message("Kein Auftrag ausgew\u00e4hlt", false); return; }
      if (!window.confirm(ids.length + " " + what + "?"))
        return;
      var params = ids.map(function(id) { return [name, id]; });
      params.push(["action", "execute"]);
      post(params);
    },
    merge: function()
    {
      var ids = checkedIds("last");
      if (ids.length == 0) { message("Keine Lastschrift ausgew\u00e4hlt", false); return; }
      if (!window.confirm(ids.length + " Lastschrift(en) zu Sammellastschriften zusammenfassen? Die Einzellastschriften werden dabei gel\u00f6scht."))
        return;
      var params = ids.map(function(id) { return ["last", id]; });
      params.push(["action", "merge"]);
      post(params);
    },
    allowAdd: function()
    {
      post([["action", "allowAdd"], ["iban", el("allow-iban").value], ["name", el("allow-name").value]])
        .then(function(ok) { if (ok) { el("allow-iban").value = ""; el("allow-name").value = ""; } });
    },
    batch: function()
    {
      var ids = checkedIds("id");
      if (ids.length == 0) { message("Keine \u00dcberweisung ausgew\u00e4hlt", false); return; }
      var params = ids.map(function(id) { return ["id", id]; });
      params.push(["action", "batch"], ["typ", el("batch-typ").value], ["datum", el("batch-datum").value]);
      post(params);
    },
    save: function()
    {
      if (!editing)
        return;
      var ed = editing;
      post([["action", "edit"], ["kind", ed.kind], ["id", ed.ref], ["betrag", el("edit-betrag").value],
            ["zweck", el("edit-zweck").value], ["datum", el("edit-datum").value], ["ziel", el("edit-ziel").value]])
        .then(function(ok) { if (ok && editing === ed) freigabe.cancel(); });
    },
    cancel: function()
    {
      editing = null;
      el("edit").style.display = "none";
    }
  };
})();
</script>

#parse("includes/footer.vm")
